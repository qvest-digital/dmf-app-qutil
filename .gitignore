# The `demo-app` entry that used to be here was for the Go binary deleted in
# 9d112b7. It outlived its purpose and became a trap: any directory by that name
# would have been ignored silently.
.DS_Store

# Local agent tooling scratch state. It is written into whichever directory is
# current, so it turns up scattered through the tree and is never a build input.
.omc/

# Bytecode from running the aggregator locally. A copy was tracked, so every
# local run produced a diff in a file nothing reads.
__pycache__/
